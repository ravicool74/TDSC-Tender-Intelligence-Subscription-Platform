# ==============================================================================
# Bihar e-Procurement Tender Subscription Platform - Environment Configuration
# Copy this file to .env and configure your local or test mode credentials.
# NEVER commit real production API keys or secret tokens to version control.
# ==============================================================================

# Server Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=true

# Security & Session Secrets (Change to strong random strings in production)
SESSION_SECRET=placeholder_change_to_random_secret_in_production
FILE_AUTH_SECRET=placeholder_change_to_random_hmac_secret_key

# Default Administrator Credentials (Initialized automatically on first boot)
ADMIN_DEFAULT_EMAIL=admin@bihar-etender.in
ADMIN_DEFAULT_PASSWORD=Admin@Eproc2026

# Payment Gateway Configuration (Razorpay Merchant Integration)
# Get your keys from Razorpay Dashboard -> Settings -> API Keys (https://dashboard.razorpay.com/#/app/keys)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_test_key_secret_do_not_commit
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret_for_signature_verification
RAZORPAY_MODE=test
RAZORPAY_COMPANY_NAME=Bihar e-Procurement Portal
RAZORPAY_THEME_COLOR=#1e3a8a

# Stale Data Threshold (Minutes after which tender data is flagged as needing refresh)
DATA_STALE_MINUTES=720
